<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">OpenExactFit</string>

    <!-- main screen -->
    <string name="sync">sync with monitor</string>
    <string name="stop">stop</string>
    <string name="export_csv">export csv</string>
    <string name="name_users">name users</string>
    <string name="auto_sync">sync when opened</string>
    <string name="background_sync">sync in the background</string>
    <string name="background_running">background sync is on: the app connects whenever the monitor is switched on.</string>
    <string name="no_readings">no readings yet. switch the monitor on, press sync, measure.</string>
    <string name="no_readings_for_user">no readings for %1$s yet.</string>
    <string name="filter_all">all</string>
    <string name="view_list">list</string>
    <string name="view_chart">chart</string>
    <string name="view_averages">averages</string>
    <string name="today">today</string>
    <string name="yesterday">yesterday</string>
    <plurals name="readings_count">
        <item quantity="one">%1$d reading</item>
        <item quantity="other">%1$d readings</item>
    </plurals>
    <string name="user_label">user %1$s</string>

    <!-- chart -->
    <string name="range_week">week</string>
    <string name="range_month">month</string>
    <string name="range_quarter">quarter</string>
    <string name="range_all">everything</string>
    <string name="no_readings_in_range">no readings in this range.</string>
    <string name="series_systolic">systolic</string>
    <string name="series_diastolic">diastolic</string>
    <string name="series_pulse">pulse</string>
    <!-- averages -->
    <!-- the count is always 7, 14 or 30, never one, so no plural forms -->
    <string name="range_days" tools:ignore="PluralsCandidate">%1$d days</string>
    <string name="averages_last_days" tools:ignore="PluralsCandidate">last %1$d days</string>
    <string name="averages_all">all</string>
    <string name="averages_day">day</string>
    <string name="averages_evening">evening</string>
    <string name="averages_hint">day: before %1$d:00, evening: from %1$d:00, by the monitor\'s clock. the calendar ring shows the band of the day\'s mean; tap a day for its averages.</string>
    <string name="averages_pick_user">pick a user above; averages across both users would mix two people.</string>
    <string name="chart_hint">dashed: trend over the readings shown, with its change next to each name. grey: 135/85 and 140/90 mmHg.</string>

    <!-- bluetooth and permissions -->
    <string name="no_bluetooth">this device has no bluetooth low energy.</string>
    <string name="bluetooth_off">bluetooth is switched off. the app needs it to find the monitor.</string>
    <string name="turn_on_bluetooth">turn on</string>
    <string name="permission_denied">without the nearby-devices permission the app cannot scan for the monitor. it is not used for location.</string>
    <string name="permission_denied_forever">the permission was refused for good. grant it in the app settings to sync.</string>
    <string name="grant_again">grant</string>
    <string name="open_settings">app settings</string>

    <!-- background service notifications -->
    <string name="channel_service">background sync</string>
    <string name="channel_readings">new readings</string>
    <string name="notification_waiting">waiting for the monitor</string>
    <string name="notification_waiting_since">waiting for the monitor, last sync %1$s</string>
    <string name="notification_syncing">connected to the monitor</string>
    <string name="notification_reading" translatable="false">%1$d/%2$d mmHg</string>

    <!-- blood pressure bands, the vendor app's colour chart -->
    <string name="category_normal">normal</string>
    <string name="category_elevated">elevated</string>
    <string name="category_high">high</string>
    <string name="category_crisis">hypertensive crisis</string>
    <string name="category_scale">bands: normal below 135/85, elevated from 135/85, high from 160/100, crisis from 180/110 mmHg. the higher of the two values decides.</string>

    <!-- reading details -->
    <string name="detail_title">%1$s/%2$s mmHg</string>
    <string name="detail_pulse">pulse %1$d /min</string>
    <string name="detail_measured">measured %1$s</string>
    <string name="detail_measured_unknown">measured at an unknown time (clock not set)</string>
    <string name="detail_received">received %1$s</string>
    <string name="detail_monitor">monitor %1$s</string>
    <string name="detail_no_flags">no warnings from the monitor</string>
    <string name="close">close</string>
    <string name="delete">delete</string>
    <string name="delete_title">delete this reading?</string>
    <string name="delete_text">it is removed from this app\'s database only. the monitor keeps it, and it will not come back over bluetooth if the monitor no longer counts it as pending.</string>
    <!-- the whole ui is lowercase prose, so the standard "Cancel" is not wanted here -->
    <string name="cancel" tools:ignore="ButtonCase">cancel</string>

    <!-- monitor status flags -->
    <string name="flag_body_movement">body movement</string>
    <string name="flag_cuff_too_loose">cuff too loose</string>
    <string name="flag_irregular_pulse">irregular pulse</string>
    <string name="flag_pulse_too_high">pulse too high</string>
    <string name="flag_pulse_too_low">pulse too low</string>
    <string name="flag_improper_position">improper position</string>

    <!-- user names dialog -->
    <string name="name_users_title">name the monitor\'s users</string>
    <string name="name_users_text">the monitor stores readings for two users, A and B, chosen with its user switch.</string>
    <string name="name_user_hint">user %1$s</string>
    <string name="save">save</string>

    <!-- export -->
    <string name="export_chooser">export csv</string>
    <string name="export_subject">exactfit readings</string>
</resources>
