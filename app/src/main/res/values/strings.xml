<!-- english ui strings in ordinary sentence case, like the german ones in values-de; the
     lowercase-prose rule of this project covers code, comments, commits and docs, not the ui.
     keep both files in step when strings change. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name" translatable="false">OpenExactFit</string>

    <!-- main screen -->
    <string name="sync">Sync with monitor</string>
    <string name="stop">Stop</string>
    <string name="export_csv">Export CSV</string>
    <string name="print">Print</string>
    <string name="import_csv">Import CSV</string>
